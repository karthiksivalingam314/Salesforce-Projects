    <description>Tracks agent-to-agent Case owner transfers, creates Case Transfer records, and updates Agent Transfer Summary records to support reporting on Cases Passed, Cases Received, and Transfer Rate by month and year.</description>
    <environments>Default</environments>
    <formulas>
        <name>CurrentMonth</name>
        <dataType>String</dataType>
        <expression>CASE(
MONTH(DATEVALUE($Flow.CurrentDateTime)),
1,&quot;January&quot;,
2,&quot;February&quot;,
3,&quot;March&quot;,
4,&quot;April&quot;,
5,&quot;May&quot;,
6,&quot;June&quot;,
7,&quot;July&quot;,
8,&quot;August&quot;,
9,&quot;September&quot;,
10,&quot;October&quot;,
11,&quot;November&quot;,
12,&quot;December&quot;,
&quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>CurrentYear</name>
        <dataType>Number</dataType>
        <expression>YEAR(DATEVALUE($Flow.CurrentDateTime))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FromAgentSummaryKey</name>
        <dataType>String</dataType>
        <expression>{!Get_Previous_Owner.Id} &amp;
&quot;-&quot; &amp;
{!CurrentMonth} &amp;
&quot;-&quot; &amp;
TEXT({!CurrentYear})</expression>
    </formulas>
    <formulas>
        <name>ToAgentSummaryKey</name>
        <dataType>String</dataType>
        <expression>{!Get_Current_Owner.Id}
&amp;
&quot;-&quot;
&amp;
{!CurrentMonth}
&amp;
&quot;-&quot;
&amp;
TEXT({!CurrentYear})</expression>
    </formulas>
