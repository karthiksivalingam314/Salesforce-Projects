    <decisions>
        <name>Determine_Skills</name>
        <label>Determine Skills</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>General</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>objVoice.Caller_Input__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Apollo Login</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objVoice.Caller_Input__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Third Party Integrations</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objVoice.Caller_Input__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Website Requests</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objVoice.Caller_Input__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Additional Support Needs</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>General_Skill</targetReference>
            </connector>
            <label>General</label>
        </rules>
        <rules>
            <name>Inventory</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>objVoice.Caller_Input__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Inventory Requests</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Inventory_Skill</targetReference>
            </connector>
            <label>Inventory</label>
        </rules>
    </decisions>
